{
  "compilerOptions": {
    "module":             "commonjs",
    "target":             "es2020",
    "outDir":             "lib",
    "strict":             true,
    "noImplicitReturns":  true,
    "noUnusedLocals":     true,
    "esModuleInterop":    true,
    "sourceMap":          true
  },
  "include": ["src"],
  "compileOnSave": true
}
