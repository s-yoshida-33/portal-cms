rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function getRole() {
      let roleDoc = get(/databases/$(database)/documents/userRoles/$(request.auth.uid));
      return roleDoc != null ? roleDoc.data.role : 'user';
    }

    function isOwner() {
      return isAuth() && getRole() == 'owner';
    }

    function isAdmin() {
      let r = getRole();
      return isAuth() && (r == 'admin' || r == 'owner');
    }

    match /projects/{projectId} {
      allow read:           if isAuth();
      allow create, update: if isAdmin();
      allow delete:         if isOwner();
    }

    match /devices/{deviceId} {
      allow read:   if isAuth();
      allow create: if isAdmin();
      allow delete: if isOwner();
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'lastSeen', 'system', 'updatedAt', 'ip', 'appVersion']);

      match /logs/{logId} {
        allow read:  if isAuth();
        allow write: if true;
      }
    }

    match /groups/{groupId} {
      allow read:           if isAuth();
      allow create, update: if isAdmin();
      allow delete:         if isOwner();
    }

    match /pendingDevices/{deviceId} {
      allow read:           if isAdmin();
      allow create:         if true;
      allow update, delete: if isAdmin();
    }

    match /tokenLookup/{hash} {
      allow get:   if true;
      allow write: if isAdmin();
    }

    match /userRoles/{uid} {
      allow read:          if isAuth();
      allow create:        if isAuth() && request.auth.uid == uid
                              && request.resource.data.role == 'user';
      allow update, delete: if isOwner();
    }

    match /apiTokens/{tokenId} {
      allow read:          if isAdmin();
      allow create:        if isAdmin();
      allow update:        if isAdmin();
      allow delete:        if false;
    }

    match /deletionRequests/{requestId} {
      allow read:   if isAuth();
      allow create: if isAdmin();
      allow update: if isOwner();
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read, write: if isOwner();
    }

    match /screenshotRequests/{requestId} {
      allow read, write: if true;
    }

    match /deviceApprovals/{approvalId} {
      allow get:           if true;
      allow create, update: if isAdmin();
      allow delete:        if false;
    }

    match /pendingDeviceApprovals/{id} {
      allow read, delete:   if true;
      allow create, update: if isAdmin();
    }

    match /siteLogs/{logId} {
      allow read:           if isAdmin();
      allow create:         if isAuth();
      allow update, delete: if false;
    }

  }
}
