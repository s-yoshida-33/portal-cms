rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function getRole() {
      let roleDoc = get(/databases/$(database)/documents/userRoles/$(request.auth.uid));
      return roleDoc != null ? roleDoc.data.role : 'user';
    }

    function isOwner() {
      return isAuth() && getRole() == 'owner';
    }

    function isAdmin() {
      let r = getRole();
      return isAuth() && (r == 'admin' || r == 'owner');
    }

    // ── プロジェクト ──────────────────────────────────────
    match /projects/{projectId} {
      allow read:           if isAuth();
      allow create, update: if isAdmin();
      allow delete:         if isOwner();
    }

    // ── デバイス ──────────────────────────────────────────
    match /devices/{deviceId} {
      allow read:           if isAuth();
      allow create, update: if isAdmin();
      allow delete:         if isOwner();
    }

    // ── 承認待ちデバイス ──────────────────────────────────
    match /pendingDevices/{deviceId} {
      allow read:           if isAdmin();
      allow create:         if false;
      allow update, delete: if isAdmin();
    }

    // ── ユーザーロール ────────────────────────────────────
    match /userRoles/{uid} {
      allow read:          if isAuth();
      allow create:        if isAuth() && request.auth.uid == uid
                              && request.resource.data.role == 'user';
      allow update, delete: if isOwner();
    }

    // ── API トークン ──────────────────────────────────────
    match /apiTokens/{tokenId} {
      allow read:          if isAdmin();
      allow create:        if isAdmin();
      allow update:        if isAdmin();
      allow delete:        if false;
    }

    // ── 削除依頼 ──────────────────────────────────────────
    match /deletionRequests/{requestId} {
      allow read:   if isAuth();
      allow create: if isAdmin();
      allow update: if isOwner();
      allow delete: if false;
    }

    // ── 通知 ──────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read, write: if isOwner();
    }
  }
}
